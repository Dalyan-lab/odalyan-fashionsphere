# Raccourcit les noms de dossiers du magasin virtuel de pnpm.
#
# Windows limite les chemins à 260 caractères tant que LongPathsEnabled vaut 0.
# Les noms par défaut de pnpm (« next@15.1.12_react-dom@19.0.0_react@19.0.0… »)
# consomment à eux seuls plus de 50 caractères, ce qui fait dépasser la limite
# aux fichiers profonds de Next.js — Windows refuse alors l'écriture et pnpm
# laisse le paquet VIDE sans signaler d'erreur.
#
# La vraie correction reste d'activer LongPathsEnabled ; ceci repasse sous la
# limite en attendant, et protège les postes où ce réglage n'est pas activé.
virtual-store-dir-max-length=40
