// Odalyan FashionSphere AI™ — Schéma de base de données (MVP Phase 1)
// Couvre : utilisateurs/auth, abonnements, boutiques (avec branding),
// produits/variantes, panier, commandes, paiements.

generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev local ; "debian-openssl-3.0.x" pour l'image Docker (node:20-bookworm-slim)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SELLER
  CUSTOMER
  MARKETING_AGENCY
}

enum SubscriptionPlan {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

/// Rayons : Mode (valeurs d'origine, à ne jamais renommer), Maison, Beauté,
/// High-tech, Enfants, Loisirs, Divers. Le rayon se déduit de la catégorie
/// côté code partagé (CATEGORY_DEPARTMENT) et n'est donc pas stocké ici.
enum ProductCategory {
  HOMME
  FEMME
  ENFANT
  LUXE
  SPORT
  ACCESSOIRES

  CUISINE
  DECORATION
  MEUBLES
  LINGE_MAISON
  JARDIN_BRICOLAGE

  SOINS_BEAUTE
  PARFUMS
  MAQUILLAGE
  CHEVEUX

  TELEPHONIE
  INFORMATIQUE
  AUDIO_IMAGE
  ELECTROMENAGER

  JOUETS
  PUERICULTURE
  SCOLAIRE

  SPORT_LOISIRS
  LIVRES_MEDIAS
  ANIMAUX
  AUTO_MOTO

  ALIMENTATION
  SANTE
  AUTRE
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum PayoutMethod {
  MOBILE_MONEY
  BANK_TRANSFER
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MOBILE_MONEY
  FLUTTERWAVE
  CINETPAY
  PAYSTACK
}

enum GeneratedAssetType {
  MANNEQUIN
  STUDIO_PHOTO
  AD_VISUAL
  AD_COPY
  AVATAR
}

enum GeneratedAssetStatus {
  PENDING
  READY
  FAILED
}

/** Classification de vélocité des produits Amazon suivis (module ViralAmazone). */
enum TrendTier {
  SUPER_NOVA // 🔴 Explosion Éclair : progression > 200% en < 12h
  HOT_WOOD // 🔥 Tendance Forte : croissance constante sur 3 jours
  SLOW_BURN // 📈 Croissance Stable : hausse régulière + avis en hausse
}

enum ScriptPlatform {
  TIKTOK
  REELS
  SHORTS
}

/** Niveau du vendeur créateur (système d'encouragement, basé sur les clics cumulés). */
enum CreatorTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  firstName    String
  lastName     String
  role         UserRole  @default(CUSTOMER)
  avatarUrl    String?
  // OAuth (préparé pour Phase ultérieure)
  googleId     String?   @unique
  facebookId   String?   @unique
  appleId      String?   @unique
  // Réinitialisation de mot de passe
  resetTokenHash String?
  resetTokenExpiry DateTime?

  shop          Shop?
  orders        Order[]
  orderGroups   OrderGroup[]
  cart          Cart?
  refreshTokens RefreshToken[]
  generatedAssets GeneratedAsset[]
  reviews       Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Shop {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  slogan      String?
  description String?

  // Branding / Boutique Premium personnalisable
  logoUrl        String?
  bannerUrl      String?
  videoUrl       String? // vidéo de présentation en tête de la vitrine
  primaryColor   String?
  secondaryColor String?
  // Affichage sur la vitrine : masquer si la bannière contient déjà le nom/slogan
  showNameOnBanner   Boolean @default(true)
  showSloganOnBanner Boolean @default(true)
  // Placement du logo (top-left|top-right|bottom-left|bottom-right) et cadrage bannière (top|center|bottom)
  logoPosition       String  @default("top-left")
  bannerPosition     String  @default("center")

  // Délai de livraison annoncé au client, en jours ouvrés. Affiché sur la fiche
  // produit et rappelé dans le suivi de commande : un acheteur qui ignore quand
  // il sera livré s'inquiète, puis réclame, puis renonce.
  deliveryDaysMin Int?
  deliveryDaysMax Int?
  deliveryNote    String? // précision libre (zones desservies, retrait en boutique…)

  // Livraison : tarif appliqué par défaut, et seuil au-delà duquel elle est
  // offerte. `null` = livraison gratuite ou incluse dans les prix.
  shippingFee      Decimal? @db.Decimal(10, 2)
  freeShippingFrom Decimal? @db.Decimal(10, 2)

  // Où reverser au vendeur ce que la plateforme a encaissé pour lui.
  payoutMethod     PayoutMethod?
  payoutOperator   String? // Wave, Orange Money, MTN, Moov, ou nom de la banque
  payoutNumber     String? // numéro Mobile Money ou coordonnées bancaires
  payoutHolderName String? // titulaire, pour éviter les virements à l'aveugle
  // Commission de la plateforme sur ce vendeur. `null` = taux général
  // (PLATFORM_COMMISSION_RATE) : un taux négocié se pose ici sans toucher
  // aux autres boutiques.
  commissionRate   Decimal? @db.Decimal(5, 4)
  // Crédits IA : solde mensuel (réinitialisé chaque mois selon le plan) + date du dernier renouvellement
  aiCredits          Int      @default(0)
  creditsRenewedAt   DateTime?
  // Crédits IA achetés en supplément (recharge Paystack) : reportés, JAMAIS réinitialisés
  aiCreditsExtra     Int      @default(0)
  // ViralAmazone : identifiant de suivi interne (sub-tag) pour attribuer les clics/ventes
  // d'affiliation Amazon à ce vendeur — le compte Associates Amazon est unique et détenu
  // par la plateforme (voir module ViralAmazone), ce tag sert au partage de revenu interne.
  affiliateTrackingId String? @unique

  // Système d'encouragement ViralAmazone (Couche 1 — voir GamificationService)
  totalClicks       Int         @default(0)
  currentStreakDays Int         @default(0)
  longestStreakDays Int         @default(0)
  lastActivityDate  DateTime?
  creatorTier       CreatorTier @default(BRONZE)

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String @unique

  subscription Subscription?
  products     Product[]
  orders       Order[]
  generatedAssets GeneratedAsset[]
  socialConnections SocialConnection[]
  reviews      Review[]
  payouts      Payout[]
  shippingRates ShippingRate[]
  scheduledPosts    ScheduledPost[]
  creditPurchases   CreditPurchase[]
  viralScripts      ViralScript[]
  affiliateClicks   AffiliateClick[]
  rewardEvents      RewardEvent[]
  creatorEarnings   CreatorEarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

/** Achat ponctuel de crédits IA (recharge) via Paystack. */
model CreditPurchase {
  id          String   @id @default(cuid())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId      String
  packId      String
  credits     Int
  amount      Decimal  @db.Decimal(12, 2)
  currency    String
  provider    String   @default("paystack")
  providerRef String   @unique
  status      String   @default("PENDING") // PENDING | PAID | FAILED
  couponCode  String? // code promo appliqué (le cas échéant)
  discountEur Decimal? @db.Decimal(10, 2) // remise appliquée (nom hérité, unité = devise plateforme)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shopId])
}

/**
 * Code promo (ex. FONDATEUR) : remise en % ou montant fixe, appliqué au paiement.
 * `appliesTo` cadre l'usage (credits pour l'instant ; subscription à venir).
 */
model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique // stocké en MAJUSCULES
  description    String?
  percentOff     Int? // 1-100
  amountOffEur   Decimal? @db.Decimal(10, 2)
  appliesTo      String   @default("credits") // credits | order | all
  maxRedemptions Int? // null = illimité
  timesRedeemed  Int      @default(0)
  active         Boolean  @default(true)
  expiresAt      DateTime?

  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

/** Utilisation d'un coupon par une boutique (une seule fois par boutique). */
model CouponRedemption {
  id           String  @id @default(cuid())
  coupon       Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId     String
  shopId       String
  context      String // ex: "credits:pack-150"
  amountOffEur Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@unique([couponId, shopId])
  @@index([shopId])
}

model Subscription {
  id        String           @id @default(cuid())
  plan      SubscriptionPlan @default(STARTER)
  active    Boolean          @default(true)
  startedAt DateTime         @default(now())
  expiresAt DateTime?
  // Dernier rappel d'expiration envoyé (dédoublonnage du cron), remis à null au renouvellement
  reminderSentAt DateTime?

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String @unique
}

/** Paiement ponctuel d'un plan (mensuel/annuel) via Paystack — active la période. */
model SubscriptionPayment {
  id          String           @id @default(cuid())
  shopId      String
  plan        SubscriptionPlan
  period      String // monthly | annual
  amount      Decimal          @db.Decimal(12, 2)
  currency    String
  provider    String           @default("paystack")
  providerRef String           @unique
  status      String           @default("PENDING") // PENDING | PAID | FAILED
  couponCode  String?
  discountEur Decimal?         @db.Decimal(10, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([shopId])
}

model Product {
  id          String          @id @default(cuid())
  name        String
  description String?
  category    ProductCategory
  price       Decimal         @db.Decimal(10, 2)
  currency    String          @default("XOF")
  status      ProductStatus   @default(DRAFT)
  images      String[]        @default([])
  videos      String[]        @default([])

  // Produit affilié (importé d'un marketplace, ex. ViralAmazone) : lien externe.
  // Quand présent, la vitrine redirige vers ce lien au lieu du panier interne.
  affiliateUrl      String? @db.Text
  sourceMarketplace String? // ex: "amazon.fr" — provenance du produit affilié

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  variants   ProductVariant[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  generatedAssets GeneratedAsset[]
  reviews    Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([category])
  @@index([status])
}

model ProductVariant {
  id            String   @id @default(cuid())
  size          String
  color         String
  sku           String?
  stock         Int      @default(0)
  priceOverride Decimal? @db.Decimal(10, 2)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

model Cart {
  id     String     @id @default(cuid())
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String     @unique
  items  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id       String @id @default(cuid())
  quantity Int    @default(1)

  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId String

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId String?

  @@unique([cartId, productId, variantId])
}

/**
 * Panier payé en une fois, éclaté en une commande par boutique.
 *
 * Un client doit pouvoir acheter chez plusieurs vendeurs sans payer plusieurs
 * fois. Mais chaque vendeur expédie, suit et se fait reverser séparément :
 * la commande reste donc l'unité de traitement, et le groupe l'unité de
 * paiement. C'est le découpage d'Amazon, où un colis par vendeur arrive à part.
 */
model OrderGroup {
  id          String  @id @default(cuid())
  reference   String  @unique
  totalAmount Decimal @db.Decimal(10, 2)
  currency    String  @default("XOF")

  customer   User   @relation(fields: [customerId], references: [id])
  customerId String

  orders  Order[]
  payment Payment?

  createdAt DateTime @default(now())

  @@index([customerId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)
  currency    String      @default("XOF")

  customer   User   @relation(fields: [customerId], references: [id])
  customerId String

  shop   Shop   @relation(fields: [shopId], references: [id])
  shopId String

  items   OrderItem[]
  payment Payment?

  shippingAddress Json?

  // Suivi de livraison, renseigné par le vendeur au passage en SHIPPED.
  // Sans ces champs, un client qui a payé n'a aucun moyen de savoir où en est
  // son colis — c'était le principal angle mort du parcours d'achat.
  carrier        String? // transporteur (DHL, Poste, livreur local…)
  trackingNumber String?
  trackingUrl    String? // page de suivi du transporteur, si elle existe
  shippedAt      DateTime?
  deliveredAt    DateTime?

  // Part du total correspondant à la livraison. Isolée parce qu'elle revient
  // entièrement au vendeur : la commission ne porte que sur les articles.
  shippingAmount Decimal? @db.Decimal(10, 2)

  // Répartition figée au moment de l'encaissement.
  //
  // Recalculer la part du vendeur à l'affichage serait une faute : changer le
  // taux de commission réécrirait alors l'historique, y compris des ventes
  // déjà réglées. Ces trois champs sont le seul enregistrement de ce qui a été
  // réellement convenu sur cette commande.
  commissionRate Decimal? @db.Decimal(5, 4)
  platformAmount Decimal? @db.Decimal(10, 2)
  sellerAmount   Decimal? @db.Decimal(10, 2)

  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  payoutId String?

  refunds Refund[]

  // Panier d'origine. Nul pour les commandes antérieures au panier
  // multi-boutiques, qui portaient leur paiement directement.
  group   OrderGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([shopId])
  @@index([status])
  @@index([payoutId])
  @@index([groupId])
}

/**
 * Tarif de livraison d'une boutique pour une zone donnée.
 *
 * Une zone se définit par des villes et/ou des pays. Les listes vides valent
 * « toutes » : une zone sans ville et sans pays est un tarif attrape-tout,
 * utile en dernière position. Les zones sont évaluées dans l'ordre de
 * `position` et la première correspondance l'emporte — c'est ce qui permet
 * d'écrire « Abidjan » avant « Côte d'Ivoire » sans ambiguïté.
 */
model ShippingRate {
  id       String   @id @default(cuid())
  name     String
  cities   String[]
  countries String[]
  fee      Decimal  @db.Decimal(10, 2)
  position Int      @default(0)

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  createdAt DateTime @default(now())

  @@index([shopId])
}

/**
 * Remboursement d'une commande.
 *
 * Le mouvement d'argent vers le client se fait à l'extérieur (Paystack,
 * Mobile Money) ; ce modèle en est la trace et, surtout, il porte la
 * **reprise de la part vendeur**.
 *
 * Deux situations opposées :
 * - la commande n'a pas encore été versée au vendeur : elle sort simplement
 *   de son solde disponible, rien d'autre à faire ;
 * - elle a déjà été versée : le vendeur détient de l'argent qui ne lui revient
 *   plus. `sellerShare` devient alors une dette, déduite de son prochain
 *   versement — `settledPayoutId` enregistre lequel l'a absorbée.
 */
model Refund {
  id        String       @id @default(cuid())
  reference String       @unique
  status    RefundStatus @default(REQUESTED)

  /// Montant rendu au client, livraison comprise le cas échéant.
  amount Decimal @db.Decimal(10, 2)
  /// Part reprise au vendeur.
  sellerShare Decimal @db.Decimal(10, 2)
  /// Commission que la plateforme abandonne.
  platformShare Decimal @db.Decimal(10, 2)
  /// Livraison rendue. Non nulle uniquement quand le remboursement solde la
  /// commande : un client qui garde un article a bien été livré.
  shippingShare Decimal @default(0) @db.Decimal(10, 2)
  /// Vrai quand ce remboursement a soldé la totalité de la commande.
  full Boolean @default(true)

  reason       String
  decisionNote String?
  decidedAt    DateTime?

  /// Versement ayant absorbé la dette, quand la commande avait déjà été payée.
  settledPayoutId String?

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Plusieurs remboursements par commande : le client peut rendre un article
  /// aujourd'hui et un autre la semaine suivante. Ce sont les lignes ci-dessous
  /// qui empêchent de rendre deux fois la même unité, pas une contrainte
  /// d'unicité sur la commande.
  orderId String

  /// Articles rendus. Vide sur les remboursements antérieurs au partiel :
  /// ils portaient toujours la commande entière.
  items RefundItem[]

  createdAt DateTime @default(now())

  @@index([status])
  @@index([settledPayoutId])
  @@index([orderId])
}

/// Une ligne de commande rendue, avec la quantité concernée.
model RefundItem {
  id       String  @id @default(cuid())
  quantity Int
  /// Prix des unités rendues, figé à la demande.
  amount Decimal @db.Decimal(10, 2)

  refund   Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  refundId String

  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String

  @@index([refundId])
  @@index([orderItemId])
}

/**
 * Versement d'un lot de commandes à un vendeur.
 *
 * Un versement regroupe les commandes livrées et sorties du délai de garantie.
 * Le mouvement d'argent lui-même reste extérieur (Wave, Orange Money, virement) :
 * ce modèle en est la trace comptable, consultable par les deux parties.
 */
model Payout {
  id        String       @id @default(cuid())
  reference String       @unique
  amount    Decimal      @db.Decimal(10, 2)
  currency  String       @default("XOF")
  status    PayoutStatus @default(PENDING)

  method PayoutMethod?
  // Coordonnées recopiées au moment du versement : si le vendeur change de
  // numéro ensuite, on doit toujours pouvoir dire où l'argent est parti.
  destination String?
  transferRef String? // référence du virement chez l'opérateur
  note        String?

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  orders Order[]

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([shopId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId String?

  refundItems RefundItem[]

  // Instantané du produit au moment de la commande
  productName String
}

model Payment {
  id            String          @id @default(cuid())
  provider      PaymentProvider @default(STRIPE)
  providerRef   String? // ex: Stripe PaymentIntent id
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("XOF")
  paid          Boolean         @default(false)
  rawPayload    Json?

  // Le paiement porte désormais sur un groupe. `orderId` reste renseigné pour
  // les commandes créées avant le panier multi-boutiques : leur vérification
  // doit continuer de fonctionner.
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String? @unique

  orderGroup   OrderGroup? @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  orderGroupId String?     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GeneratedAsset {
  id       String               @id @default(cuid())
  type     GeneratedAssetType
  status   GeneratedAssetStatus @default(READY)
  provider String // "openai" | "anthropic" | "mock"
  prompt   String?
  url      String? // image générée (URL ou data URI)
  meta     Json? // texte publicitaire, options, etc.

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?

  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([type])
}

model SocialConnection {
  id          String    @id @default(cuid())
  network     String // Facebook, Instagram, TikTok, YouTube, Pinterest, X
  connected   Boolean   @default(false)
  accountName String?
  accessToken String?   @db.Text // jeton OAuth (placeholder en mode simulé)
  connectedAt DateTime?

  // Publication réelle : jetons et identifiants renvoyés par le réseau
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?
  externalId     String? // ex: id de Page Facebook ou de compte Instagram Business
  scope          String? // permissions accordées
  simulated      Boolean   @default(true) // false quand la connexion est un vrai compte OAuth

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  @@unique([shopId, network])
}

model ScheduledPost {
  id          String    @id @default(cuid())
  caption     String
  imageUrl    String?
  videoUrl    String?   // vidéo à publier (TikTok, Reels…) ; prioritaire sur l'image
  networks    String[]  @default([])
  scheduledAt DateTime
  status      String    @default("SCHEDULED") // SCHEDULED | PUBLISHED | PARTIAL | FAILED | CANCELLED
  publishedAt DateTime?

  // Résultat détaillé par réseau : { "Instagram": { ok, externalId?, error? }, … }
  results   Json?
  attempts  Int     @default(0)
  lastError String? @db.Text

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  insights PostInsight[]

  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([status])
}

/**
 * Statistiques d'une publication sur un réseau donné, rafraîchies périodiquement
 * depuis l'API du réseau. Une ligne par (publication, réseau) : les chiffres sont
 * remplacés à chaque rafraîchissement (on stocke l'état courant, pas l'historique).
 */
model PostInsight {
  id      String @id @default(cuid())
  network String

  /** Id du contenu côté réseau (post Facebook, média Instagram, vidéo TikTok). */
  externalId String?

  views    Int @default(0) // impressions / vues
  reach    Int @default(0) // comptes uniques touchés (quand le réseau le fournit)
  likes    Int @default(0)
  comments Int @default(0)
  shares   Int @default(0)

  /** Dernière tentative de récupération, et son échec éventuel (permission manquante…). */
  fetchedAt DateTime @default(now())
  error     String?  @db.Text

  post   ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  @@unique([postId, network])
  @@index([postId])
}

// ────────────────────────────────────────────────────────────────────────
// ViralAmazone Trend Machine — tracker de tendances Amazon + générateur de
// scripts viraux. Données sourcées via Amazon PA-API (officielle) + Keepa
// (historique de rang), jamais par scraping direct.
// ────────────────────────────────────────────────────────────────────────

/** Produit Amazon suivi (identité stable ASIN + marketplace, état courant). */
model AmazonProduct {
  id          String @id @default(cuid())
  asin        String
  marketplace String // domaine Amazon ciblé, ex: "amazon.fr", "amazon.com"
  title       String
  imageUrl    String?
  category    String?
  productUrl  String @db.Text

  // État courant (rafraîchi périodiquement via PA-API/Keepa)
  currentRank   Int?
  currentPrice  Decimal? @db.Decimal(12, 2)
  currency      String?
  reviewCount   Int?
  rating        Decimal? @db.Decimal(3, 2)
  lastCheckedAt DateTime?

  // Vélocité calculée (voir TrendsService) + classification
  velocity3h  Float?
  velocity12h Float?
  velocity24h Float?
  trendTier   TrendTier?

  snapshots AmazonRankSnapshot[]
  scripts   ViralScript[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([asin, marketplace])
  @@index([trendTier])
  @@index([category])
}

/** Relevé horodaté du rang de vente — série temporelle pour le calcul de vélocité. */
/**
 * Rayon Amazon dont on suit automatiquement les meilleures ventes.
 *
 * Remplace la curation manuelle : au lieu d'ajouter les ASIN un par un, on
 * déclare un rayon et la plateforme y pioche le haut du classement à chaque
 * passage. `category` accepte un identifiant de nœud Amazon ou un nom de
 * groupe d'affichage (« beauty »), ce dernier étant portable entre pays.
 */
model TrendWatch {
  id          String  @id @default(cuid())
  label       String
  marketplace String
  category    String
  /// Combien de produits reprendre en tête de classement à chaque passage.
  topN        Int     @default(10)
  active      Boolean @default(true)

  lastRunAt   DateTime?
  lastCount   Int?
  lastError   String?

  createdAt DateTime @default(now())

  @@unique([marketplace, category])
  @@index([active])
}

model AmazonRankSnapshot {
  id          String        @id @default(cuid())
  product     AmazonProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  salesRank   Int
  price       Decimal?      @db.Decimal(12, 2)
  reviewCount Int?
  rating      Decimal?      @db.Decimal(3, 2)
  capturedAt  DateTime      @default(now())

  @@index([productId, capturedAt])
}

/** Script vidéo viral généré par IA pour un produit, propre à un vendeur. */
model ViralScript {
  id        String         @id @default(cuid())
  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId    String
  product   AmazonProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  platform  ScriptPlatform @default(TIKTOK)

  hook     String @db.Text
  problem  String @db.Text
  solution String @db.Text
  cta      String @db.Text

  affiliateUrl String @db.Text
  provider     String // 'anthropic' | 'openai' | 'mock'

  clicks AffiliateClick[]

  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([productId])
}

/**
 * Clic enregistré sur le lien traçant maison (/go/:scriptId) avant redirection vers
 * Amazon. Sert de proxy immédiat à l'intérêt généré (Amazon ne donne aucune donnée
 * de commission en temps réel) — alimente les niveaux, jalons et le classement.
 * Un clic dédupliqué (même boutique+script+IP dans les 30 min) n'est pas ré-inséré.
 */
model AffiliateClick {
  id       String      @id @default(cuid())
  shop     Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId   String
  script   ViralScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  scriptId String
  ipHash   String

  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([scriptId, ipHash, createdAt])
}

/**
 * Récompense accordée au vendeur (crédits IA bonus) — jalon de clics, de série,
 * passage de niveau ou classement hebdomadaire. `key` garantit l'octroi UNIQUE
 * (idempotent) par boutique, et sert d'historique visible côté dashboard.
 */
model RewardEvent {
  id      String @id @default(cuid())
  shop    Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId  String
  kind    String // 'CLICK_MILESTONE' | 'STREAK_MILESTONE' | 'TIER_UP' | 'LEADERBOARD'
  key     String // identifiant unique du jalon, ex: 'clicks_100', 'streak_7', 'tier_GOLD'
  credits Int    @default(0)

  createdAt DateTime @default(now())

  @@unique([shopId, key])
  @@index([shopId])
}

/// Avis client sur un produit (note 1–5 + commentaire).
model Review {
  id        String   @id @default(cuid())
  rating    Int // 1 à 5
  comment   String?  @db.Text
  author    String // nom affiché de l'auteur

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  // Auteur connecté (un avis par utilisateur et par produit). Null = invité éventuel.
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId])
  @@index([shopId])
}

/// Bandeau de tête de la marketplace : promotion, saison, annonce.
///
/// Stocké en base plutôt que codé dans la page : une opération commerciale se
/// décide la veille pour le lendemain, et personne ne devrait avoir à
/// redéployer le site pour lancer des soldes.
model MarketplaceBanner {
  id       String  @id @default(cuid())
  title    String
  subtitle String?

  /// Pastille de tête : « PROMO », « NOUVEAU », « DERNIERS JOURS »…
  badge String?
  /// Ton de la pastille : décide de sa couleur et de son animation.
  tone String @default("PROMO") // PROMO | NEW | ALERT | INFO

  ctaLabel String?
  ctaUrl   String?

  /// Média de fond. La vidéo prime sur l'image quand les deux sont fournies.
  imageUrl String?
  videoUrl String?

  /// Ambiance colorée, pour habiller le bandeau même sans média.
  theme String @default("violet") // violet | or | nuit | ete | fete

  /// Hauteur du bandeau. Une vidéo 16:9 posée dans un bandeau très large perd
  /// une grande part de sa hauteur ; « grand » en montre 70 % contre 41 % pour
  /// « compact ».
  height String @default("standard") // compact | standard | grand
  /// Partie du média conservée au recadrage : c'est ce qui décide de ce qui
  /// survit à la coupe.
  mediaPosition String @default("center") // top | center | bottom
  /// Animation appliquée à l'image de fond. « orbit » anime les univers
  /// produits sans passer par une vidéo — donc sans recadrage ni compression.
  animation String @default("none") // none | orbit

  active Boolean @default(true)
  /// Fenêtre de diffusion. Deux dates nulles = permanent, ce qui permet de
  /// préparer une saison à l'avance sans la rendre visible.
  startsAt DateTime?
  endsAt   DateTime?
  /// Le plus élevé l'emporte quand plusieurs bandeaux se chevauchent.
  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, priority])
}

/// Statut d'une écriture au registre des gains d'affiliation.
enum CreatorEarningStatus {
  AVAILABLE // gain acquis, disponible au retrait
  REQUESTED // retrait demandé par le vendeur, en attente
  PAID // retrait versé
  REJECTED // écriture annulée (erreur, litige) — exclue du solde
}

/// Registre des gains ViralAmazone d'une boutique, en francs CFA.
///
/// Volontairement SÉPARÉ des crédits IA. Les crédits s'achètent : les
/// convertir en argent permettrait d'acheter un pack puis de l'encaisser, et
/// la plateforme paierait deux fois la même somme. Ici seules les
/// performances d'affiliation créditent le registre.
///
/// Un registre plutôt qu'un solde stocké : le solde se recalcule en
/// additionnant les écritures, donc il ne peut pas dériver de son historique,
/// et chaque mouvement reste justifiable devant un vendeur qui conteste.
model CreatorEarning {
  id     String @id @default(cuid())
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  /// Positif = gain crédité, négatif = retrait. Le solde est leur somme.
  amount   Decimal              @db.Decimal(10, 2)
  currency String               @default("XOF")
  status   CreatorEarningStatus @default(AVAILABLE)

  /// Origine lisible : 'affiliate' | 'bonus' | 'withdrawal' | 'adjustment'
  kind String
  note String?

  /// Coordonnées visées par le retrait, figées au moment de la demande :
  /// le vendeur peut les changer ensuite sans réécrire l'historique.
  destination String?
  transferRef String?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status])
}
